# 服务器文件：复制到部署 root/deploy.yaml，不放入 bundle。
name: example-app
release:
  provider: github
  repository: owner/repository
  asset: bundle-linux-arm64.zip
service:
  user: example-app
  group: example-app
  unit: example-app.service
# 可选：CI 发布 Release 后自动触发 upy 部署；只保存在服务器，不放入 bundle。
# webhook:
#   secret: "与 GitHub Actions Secret UPY_WEBHOOK_SECRET 一致的随机密钥"
# 可选：bundle 纯 Go AES-256-GCM 强解密；若在公开 Release 发布了加密包时配置，只保存在服务器，不放入 bundle。
# crypto:
#   password: "your-strong-password"
