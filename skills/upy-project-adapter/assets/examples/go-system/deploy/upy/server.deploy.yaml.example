# 服务器 /srv/demo-api/deploy.yaml；不要放进 bundle。
name: demo-api
release:
  provider: github
  repository: owner/demo-api
  asset: bundle-linux-arm64.zip
service:
  user: api
  group: api
  unit: demo-api.service
# 可选：CI 发布 Release 后自动触发 upy 部署；只保存在服务器，不放入 bundle。
# webhook:
#   secret: "与 GitHub Actions Secret UPY_WEBHOOK_SECRET 一致的随机密钥"
# 可选：bundle 强解密密码 (只保存在服务器，不放入 bundle)
# crypto:
#   password: "your-strong-password"
